# 논리 키 목록 — 운영에서 환경변수로 줄 때의 이름이다 (Spring 이 DB_WRITER_PASSWORD → db-writer-password 로 대응시킨다).
# aws·azure·gcp 프로필을 쓰면 비밀 값은 비밀 저장소에 같은 논리 키 이름(kebab-case)으로 둔다. README 「설정과 비밀값」 참고.
# 이 파일을 .env 로 복사해 쓸 수 있다 (.env 는 커밋하지 않는다).

# --- 설정 (비밀 아님) ---
DB_HOST=localhost
DB_PORT=3306
# DB_READ_HOST=           # 읽기 복제본 호스트 (없으면 DB_HOST)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_SSL_ENABLED=false
# REDIS_MANAGED_CLUSTER=false   # 관리형 Redis 클러스터(단일 엔드포인트)면 true
CORE_API_URL=http://localhost:9999

# --- 비밀 ---
DB_READER_USERNAME=skeleton_reader
DB_READER_PASSWORD=
DB_WRITER_USERNAME=skeleton_writer
DB_WRITER_PASSWORD=
REDIS_PASSWORD=

# --- 비밀값 출처 프로필 (SPRING_PROFILES_ACTIVE=aws|azure|gcp, 필요하면 ,loki) ---
# AWS_SECRET_ID=internal-api-skeleton/prod
# AZURE_KEYVAULT_ENDPOINT=https://<vault-name>.vault.azure.net/
# AZURE_KEYVAULT_CHALLENGE_RESOURCE_VERIFICATION_ENABLED=true   # 에뮬레이터·사설 엔드포인트에서만 false
# GCP_PROJECT_ID=<project-id>
# LOKI_URL=http://loki:3100/loki/api/v1/push
